{
  "name": "mwaila-graduation-invitation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.x",
    "npm": ">=10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local database/migrate.mjs up",
    "db:migrate:down": "node --env-file=.env.local database/migrate.mjs down",
    "rsvp:anonymize": "node --env-file=.env.local database/anonymize.mjs",
    "admin:bootstrap": "node database/bootstrap-admin.mjs"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.17",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
