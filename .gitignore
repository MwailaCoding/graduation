# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build outputs
/.next/
/out/
/build/

# Environment variables (ignore all secret env files; allow placeholder template)
.env*
!.env.example

# TypeScript & test artifacts
*.tsbuildinfo
next-env.d.ts
/coverage

# Debug logs & OS files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Large raw media & uncompressed assets (offloaded to Cloudflare R2 / AWS S3 / CDN)
assets/*
!assets/README.md
!assets/inventory/
assets/inventory/*
!assets/inventory/ASSET-INVENTORY.md
assets/raw/
assets/heavy-media/
