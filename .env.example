# PostgreSQL connection string (PrimeCloud or local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Public site domain URL (used by WhatsApp, iMessage, and social media link previews)
# Replace with your deployed domain, e.g. https://mwaila-graduation.primecloud.app
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Server-only HMAC pepper for PostgreSQL rate-limit & audit IP buckets (generate >= 32 random bytes hex)
RATE_LIMIT_PEPPER=""

# Server-only secret for admin session token HMAC/hashing (generate >= 32 random bytes hex)
ADMIN_SESSION_SECRET=""

# Non-public CLI admin bootstrap variables (used only by `npm run admin:bootstrap`, never exposed in HTTP APIs)
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME=""
